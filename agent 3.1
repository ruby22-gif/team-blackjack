# ---- experiment knobs: set as environment variables, e.g.  $env:V9_BLUFF_FLOP="0.3" ----
_DEFAULTS = {
    "SAMPLES": 32.0,        # equity samples (32 = exactly V3)
    "PF_CALL": 45.0,        # V3 calls facing a raise with preflop score >= this
    "PF_RAISE": 70.0,       # V3 re-raises pot facing a raise with score >= this
    "CALL_DELTA": 0.0,      # added to V3's postflop call thresholds (+ = fold more)
    "STEAL_SB": 0.0,        # prob. to raise pot preflop with hands V3 would fold facing the blind
    "LIMP_RAISE": 0.0,      # prob. to raise pot preflop with hands V3 would just call
    "BLUFF_FLOP": 0.0,      # prob. to bet pot when V3 would check (weak hand), by street
    "BLUFF_TURN": 0.0,
    "BLUFF_RIVER": 0.0,
    "VALUE_HALF": 0.0,      # prob. to bet half pot with medium hands (strength >= 0.45) V3 would check
    "RERAISE_FLOP": 0.0,    # prob. to raise pot facing a bet when V3 would fold, by street
    "RERAISE_TURN": 0.0,
    "RERAISE_RIVER": 0.0,
}
CFG = {}
for _k, _d in _DEFAULTS.items():
    try:
        CFG[_k] = float(os.environ.get("V9_" + _k, _d))
    except ValueError:
        CFG[_k] = _d

SAMPLES_NORMAL = 80      # v3 used 32; more samples = fewer noise-driven folds/calls
SAMPLES_FAST = 32        # fallback once the time budget is mostly used
TIME_BUDGET = 5.0        # seconds of request handling per half before falling back (hard limit 8s)


def _rank_histogram(cards):
    counts = [0] * 9
    for c in cards:
        counts[card_rank(c)] += 1
    return counts


def _suit_histogram(cards):
    counts = [0] * 4
    for c in cards:
        counts[card_suit(c)] += 1
    return counts


def evaluate_preflop(hole_cards):
    ranks = [card_rank(c) for c in hole_cards]
    rank_counts = _rank_histogram(hole_cards)
    suit_counts = _suit_histogram(hole_cards)
    score = 0
    pairs = sum(1 for cnt in rank_counts if cnt >= 2)
    trips = sum(1 for cnt in rank_counts if cnt >= 3)
    score += pairs * 18
    score += trips * 25
    high_cards = sum(1 for r in ranks if r >= 6)
    score += high_cards * 6
    if 8 in ranks:
        score += 8
    max_suited = max(suit_counts)
    if max_suited >= 3:
        score += 15
    elif max_suited == 2:
        score += 8
    unique_ranks = sorted(set(ranks))
    conn = 0
    for i in range(len(unique_ranks) - 1):
        if unique_ranks[i + 1] - unique_ranks[i] == 1:
            conn += 1
    score += conn * 7
    return score


def evaluate_postflop(obs: Observation):
    hole = obs.hole_cards
    board = obs.board
    if len(board) == 5:
        my_score = omaha_score(hole, board)
    else:
        table = get_table()
        hole_pairs = [((1 << a) | (1 << b)) for a, b in combinations(hole, 2)]
        board_triples = [((1 << a) | (1 << b) | (1 << c))
                         for a, b, c in combinations(board, 3)]
        my_score = max(table[hm | bm] for hm in hole_pairs for bm in board_triples)
    cat = my_score >> 20
    strength_map = {0: 0.1, 1: 0.25, 2: 0.45, 3: 0.65, 4: 0.75,
                    5: 0.85, 6: 0.92, 7: 0.98, 8: 1.0}
    strength = strength_map.get(cat, 0.3)
    if len(board) == 5:
        return strength
    suit_counts_board = _suit_histogram(board)
    suit_counts_hole = _suit_histogram(hole)
    for suit in range(4):
        if suit_counts_hole[suit] >= 2 and suit_counts_board[suit] >= 2:
            strength = max(strength, 0.70)
    return strength


def estimate_equity(obs: Observation, memory: dict) -> float:
    """Showdown equity vs a random unseen five-card hand (more samples than v3)."""
    samples = int(CFG["SAMPLES"]) if memory.get("spent", 0.0) < TIME_BUDGET else SAMPLES_FAST
    hole, board = tuple(obs.hole_cards), tuple(obs.board)
    known = set(hole + board)
    unseen = [card for card in range(36) if card not in known]
    seed = obs.hand_index * 1315423911 + len(obs.action_history) * 2654435761
    seed += sum((i + 1) * (card + 1) * 101 for i, card in enumerate(hole + board))
    rng = random.Random(seed)
    wins = 0.0
    for _ in range(samples):
        drawn = rng.sample(unseen, 10 - len(board))
        opp_hole = drawn[:5]
        full_board = board + tuple(drawn[5:])
        mine = omaha_score(hole, full_board)
        theirs = omaha_score(opp_hole, full_board)
        wins += 1.0 if mine > theirs else 0.5 if mine == theirs else 0.0
    return wins / samples


def new_half(config: AgentConfig, memory: dict) -> None:
    memory["spent"] = 0.0


def _v3_action(obs: Observation, memory: dict) -> Action:
    legal = obs.legal_actions
    to_call = obs.to_call
    pot = obs.pot
    pot_odds = to_call / max(1, pot + to_call)

    if obs.street == Street.PREFLOP:
        pf_score = evaluate_preflop(obs.hole_cards)
        if to_call == 0:
            if pf_score >= 65 and Action.RAISE_POT in legal:
                return Action.RAISE_POT
            if pf_score >= 50 and Action.RAISE_HALF in legal:
                return Action.RAISE_HALF
            return Action.CHECK_CALL
        if pf_score >= CFG["PF_RAISE"] and Action.RAISE_POT in legal:
            return Action.RAISE_POT
        if pf_score >= CFG["PF_CALL"]:
            return Action.CHECK_CALL if Action.CHECK_CALL in legal else Action.FOLD
        if pot_odds < 0.25 and pf_score >= 35:
            return Action.CHECK_CALL
        return Action.FOLD

    hand_strength = evaluate_postflop(obs)

    if hand_strength >= 0.80:
        if Action.RAISE_POT in legal:
            return Action.RAISE_POT
        if Action.RAISE_HALF in legal:
            return Action.RAISE_HALF
        return Action.CHECK_CALL

    if hand_strength >= 0.60:
        if to_call == 0 and Action.RAISE_HALF in legal:
            return Action.RAISE_HALF
        if to_call > 0 and hand_strength < 0.80:
            if estimate_equity(obs, memory) < max(0.50, pot_odds + 0.12) + CFG["CALL_DELTA"]:
                return Action.FOLD
        if Action.CHECK_CALL in legal:
            return Action.CHECK_CALL

    if to_call > 0 and hand_strength < 0.60:
        if estimate_equity(obs, memory) >= max(0.42, pot_odds + 0.10) + CFG["CALL_DELTA"]:
            return Action.CHECK_CALL
        return Action.FOLD

    if hand_strength >= 0.40:
        if to_call == 0:
            return Action.CHECK_CALL
        if pot_odds <= 0.35 and Action.CHECK_CALL in legal:
            return Action.CHECK_CALL

    if to_call == 0:
        return Action.CHECK_CALL
    return Action.FOLD


def _spot_roll(obs: Observation, salt: int) -> float:
    """Deterministic pseudo-random number per decision spot (so runs are reproducible)."""
    seed = obs.hand_index * 1315423911 + len(obs.action_history) * 2654435761 + salt * 7919
    seed += sum((i + 1) * (card + 1) * 101 for i, card in enumerate(tuple(obs.hole_cards) + tuple(obs.board)))
    return random.Random(seed).random()


def choose_action(obs: Observation, memory: dict) -> Action:
    base = _v3_action(obs, memory)
    legal = obs.legal_actions
    to_call = obs.to_call
    nb = len(obs.board)

    def pot_or(a):
        return a if a in legal else base

    if obs.street == Street.PREFLOP:
        if to_call > 0 and base == Action.FOLD and CFG["STEAL_SB"] > 0:
            if _spot_roll(obs, 1) < CFG["STEAL_SB"]:
                return pot_or(Action.RAISE_POT)
        if to_call > 0 and base == Action.CHECK_CALL and CFG["LIMP_RAISE"] > 0:
            if _spot_roll(obs, 2) < CFG["LIMP_RAISE"]:
                return pot_or(Action.RAISE_POT)
        return base

    street = {3: "FLOP", 4: "TURN", 5: "RIVER"}.get(nb)
    if street is None:
        return base
    if to_call == 0 and base == Action.CHECK_CALL:
        strong = CFG["VALUE_HALF"] > 0 and evaluate_postflop(obs) >= 0.45
        if strong:
            if _spot_roll(obs, 3) < CFG["VALUE_HALF"]:
                return pot_or(Action.RAISE_HALF)
        elif CFG["BLUFF_" + street] > 0:
            if _spot_roll(obs, 4) < CFG["BLUFF_" + street]:
                return pot_or(Action.RAISE_POT)
    elif to_call > 0 and base == Action.FOLD and CFG["RERAISE_" + street] > 0:
        if _spot_roll(obs, 5) < CFG["RERAISE_" + street]:
            return pot_or(Action.RAISE_POT)
    return base


